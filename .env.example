# Copy to .env. The defaults below work with docker compose as-is.
# .env is gitignored; nothing real belongs in this file.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Host names are the compose service names.
DATABASE_URL=postgresql://visitnote:visitnote@postgres:5432/visitnote
REDIS_URL=redis://redis:6379/0

# Development value only. Production generates one with:  openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-32chars-min

CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,api

# --- Providers (phase 4) -----------------------------------------------------
# Model identifiers live here and in note_templates, never in pipeline code.
LLM_PROVIDER=anthropic
LLM_MODEL_ID=claude-sonnet-5
ANTHROPIC_API_KEY=

TRANSCRIPTION_PROVIDER=deepgram
TRANSCRIPTION_MODEL_ID=nova-3
DEEPGRAM_API_KEY=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Never send transcript or note text to a tracing backend in production.
LANGFUSE_REDACT_CONTENT=true
